# Copy to .env only inside a private live workspace. Never commit real values.
# Model request keys (used only by the LiteLLM example proxy / run_workload.py)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Admin keys (used only by `aiecon billing sync`; never read by model-calling code)
OPENAI_ADMIN_API_KEY=
ANTHROPIC_ADMIN_API_KEY=
# Real model IDs for the live path (must resolve in catalogs/live-demo.json)
AIECON_OPENAI_MODEL=
AIECON_ANTHROPIC_MODEL=
# Default workspace directory
AIECON_WORKSPACE=.aiecon/live
# Dataset id the collector stamps on every call (report and reconcile select by it)
AIECON_DATASET_ID=live-demo
# Fallback scope id for requests whose metadata carries none; billing sync --scope-id must
# use the same value as the calls (run_workload.py sends live_openai_project /
# live_anthropic_workspace explicitly)
AIECON_SCOPE_ID=
# Local HMAC key for prefix fingerprints (never logged or reported)
AIECON_FINGERPRINT_KEY=
